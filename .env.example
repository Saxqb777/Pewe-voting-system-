# Postgres connection string from Neon. Use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The single admin password. Choose a long one you will remember.
ADMIN_PASSWORD="change-this-to-something-long"

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-64-character-random-hex-string"

# How many voters the roster must contain. The loader refuses any other count.
# Change this here or in your hosting settings if the village list changes size.
EXPECTED_VOTER_COUNT="138"

# How many names each voter must select. The ballot enforces exactly this many.
SELECTIONS_REQUIRED="17"
