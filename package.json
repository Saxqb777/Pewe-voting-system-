{
  "name": "village-voting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.mts",
    "verify:anonymity": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-anonymity.ts",
    "test:ballot-box": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/test-ballot-box.mts",
    "test:roster": "tsx --conditions=react-server scripts/test-roster.mts",
    "test": "npm run test:roster && npm run test:ballot-box && npm run verify:anonymity"
  },
  "dependencies": {
    "next": "16.3.3",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
